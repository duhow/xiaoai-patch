+/* Fast integer soft-knee boost (~3x for quiet whisper, no -lm needed) */
+static void boost_whisper(short *buf, int len) {
+  int i;
+  for (i = 0; i < len; i++) {
+    int x = buf[i];
+    int abs_x = (x < 0) ? -x : x;
+    if (abs_x > 32767) abs_x = 32767;
+
+    /* Cubic soft-knee curve in Q15 fixed-point: y = 3*x - 2*x^3 */
+    long long nx = abs_x;
+    long long nx2 = (nx * nx) >> 15;
+    long long factor = (3 << 15) - (2 * nx2);
+    int out = (int)((nx * factor) >> 15);
+
+    if (out > 32767) out = 32767;
+    buf[i] = (x < 0) ? (short)(-out) : (short)out;
+  }
+}

