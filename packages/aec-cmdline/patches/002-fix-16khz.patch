+typedef struct {
+  float prev_in;
+  float prev_out;
+} HPFState;
+
+/* Gentle 1st-order High-Pass Filter (~140 Hz @ 16000 Hz, alpha = 0.946) */
+static void apply_hpf(short *buf, int len, HPFState *st) {
+  int i;
+  float prev_in = st->prev_in;
+  float prev_out = st->prev_out;
+  for (i = 0; i < len; i++) {
+    float x = (float)buf[i];
+    float y = 0.946f * (prev_out + x - prev_in);
+    prev_in = x;
+    prev_out = y;
+    if (y > 32767.0f) y = 32767.0f;
+    if (y < -32768.0f) y = -32768.0f;
+    buf[i] = (short)y;
+  }
+  st->prev_in = prev_in;
+  st->prev_out = prev_out;
+}
 
